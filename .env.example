# ---- TripStash environment ----------------------------------------------
# Copy to .env and adjust. Every value below has a working default so the
# stack boots with no external accounts (see docs/architecture.md).

# Database. Postgres+PostGIS is the deployment target; SQLite is the
# zero-dependency dev/test fallback and is used automatically when unset.
TRIPSTASH_DATABASE_URL=postgresql+psycopg://tripstash:tripstash@localhost:5432/tripstash

# Session signing. MUST be replaced outside local development.
TRIPSTASH_SECRET_KEY=dev-only-insecure-change-me
TRIPSTASH_ACCESS_TOKEN_TTL_MINUTES=43200

# Private object storage root (local driver). Signed URLs are HMAC scoped.
TRIPSTASH_STORAGE_DIR=var/storage
TRIPSTASH_SIGNED_URL_TTL_SECONDS=600
TRIPSTASH_MAX_UPLOAD_BYTES=209715200

# Provider adapters: "fake" runs deterministic in-repo implementations.
# "local" runs free open weights through any OpenAI-compatible server
# (Ollama, llama.cpp, LM Studio, vLLM). See docs/local-model.md.
TRIPSTASH_AI_PROVIDER=fake
TRIPSTASH_PLACES_PROVIDER=fake
TRIPSTASH_WEATHER_PROVIDER=fake
TRIPSTASH_FX_PROVIDER=fake
TRIPSTASH_STORAGE_PROVIDER=local

# Local model (only read when TRIPSTASH_AI_PROVIDER=local). No API key, no cost.
TRIPSTASH_LLM_BASE_URL=http://localhost:11434/v1
TRIPSTASH_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
TRIPSTASH_LLM_TIMEOUT_SECONDS=120
# Only for servers that demand one; local runtimes usually do not.
TRIPSTASH_LLM_API_KEY=

# Real-provider credentials (only read when the matching provider is enabled)
TRIPSTASH_PLACES_API_KEY=
TRIPSTASH_WEATHER_API_KEY=

# Reading what a pasted link publishes about itself (oEmbed, Open Graph).
TRIPSTASH_LINK_FETCH_ENABLED=true
TRIPSTASH_LINK_TIMEOUT_SECONDS=15

# Media understanding. OCR weights ship inside the wheel and run offline;
# speech to text needs the `asr` extra and fetches its model once.
TRIPSTASH_MEDIA_ENABLED=true
TRIPSTASH_MEDIA_ASR=true
TRIPSTASH_MEDIA_OCR=true
TRIPSTASH_MEDIA_MAX_FRAMES=12
TRIPSTASH_MEDIA_MAX_DURATION_SECONDS=900
TRIPSTASH_MEDIA_ASR_MODEL=small

# Extraction worker
TRIPSTASH_WORKER_INLINE=true
